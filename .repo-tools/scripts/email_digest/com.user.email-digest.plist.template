<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.email-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mike_erlihson/personal/repos/scientific-resources/.repo-tools/scripts/email_digest/venv/bin/python3</string>
        <string>-m</string>
        <string>email_digest.scheduler</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mike_erlihson/personal/repos/scientific-resources/.repo-tools/scripts</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <!-- Daily at 10:00 with hourly retries to 14:00. The scheduler covers all
         days since the last successful run and skips once today's digest was sent,
         so retries are safe and self-heal a failed run (e.g. Mac offline at 10:00). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Also run on login/wake -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mike_erlihson/.config/email-digest/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mike_erlihson/.config/email-digest/launchd_stderr.log</string>
</dict>
</plist>
