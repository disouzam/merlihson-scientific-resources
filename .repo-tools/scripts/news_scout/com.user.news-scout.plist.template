<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.news-scout</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/.repo-tools/.venv/bin/python3</string>
        <string>-m</string>
        <string>news_scout.news_scout</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/.repo-tools/scripts</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- Primary slot: 08:00 daily. Hourly retries until 12:00 protect against
         transient failures (no network on wake, RSS source flaking, etc.).
         The script checks last_run.txt and exits in milliseconds if already done. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>8</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>10</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>11</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>12</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <!-- Run at load (login/wake) so a missed early slot still fires once the laptop is on. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/.repo-tools/logs/news_scout.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/.repo-tools/logs/news_scout.log</string>
</dict>
</plist>
