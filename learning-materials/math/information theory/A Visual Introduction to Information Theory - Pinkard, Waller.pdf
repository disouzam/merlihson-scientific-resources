            <rdf:Alt>
               <rdf:li xml:lang="x-default">p({\texttt{blue}}) = \tfrac{1}{2} \\&#xD;p({\texttt{gray}}) = \tfrac{1}{4} \\&#xD;p({\texttt{yellow}}) =\tfrac{1}{8} \\&#xD;p({\texttt{green}}) =\tfrac{1}{8} \\&#xD;&#xD;\texttt{00000010100110111011001101110100} \\&#xD;\texttt{1001110001010000011101011011} \\&#xD;\tfrac{\text{length}}{\text{\# events}} = \tfrac{32}{16} = 2 \text{ bits}\\&#xD;\tfrac{\text{length}}{\text{\# events}} = \tfrac{28}{16} = 1.75 \text{ bits}&#xD;\texttt{1110} \ \  \texttt{1110000} \\&#xA;\texttt{1010} \ \  \texttt{1010011}\\&#xA;\texttt{0100} \ \  \texttt{0100011}\\&#xA;\texttt{0011} \ \  \texttt{0011010}\\</rdf:li>
