            <rdf:Alt>
               <rdf:li xml:lang="x-default">p(x, y) = p(y \mid x)p(x) \\&#xD;P_\mathrm{X} P_\mathrm{Y} P_\mathrm{Y \mid X}  P_\mathrm{Y,X}  \\&#xD;\\&#xD;\textbf{p}_\mathrm{Y}  = \textbf{P}_\mathrm{Y \mid X} \textbf{p}_\mathrm{X} \\&#xD;\textbf{p}_\mathrm{Y,X} = \textbf{P}_\mathrm{Y \mid X} \text{diag}(\textbf{p}_\mathrm{X}) &#xD;&#xD;</rdf:li>
            </rdf:Alt>
         </dc:description>
